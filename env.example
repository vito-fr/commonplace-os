# archive — environment variables
#
# Copy this file to .env and fill in real values for local development.
# Never commit .env. See .gitignore.
#
# v0.1 is local-only. Production-only variables (Tailscale, Cloudflare R2,
# Litestream) are documented in docs/runbooks/environment.md when v1 begins.

# --- PocketBase ---

# Local PocketBase URL. Default for local dev.
POCKETBASE_URL=http://127.0.0.1:8090

# Owner credentials for the seed loader. Created during M0.1 setup via the
# PocketBase admin UI. These are local-dev credentials only — production
# credentials never live in .env.
OWNER_EMAIL=
OWNER_PASSWORD=

# --- External imports ---

# Personal access token from https://www.are.na/settings/personal-access-tokens.
# Required by the local PocketBase Are.na import route.
ARENA_API_KEY=

# --- Ollama (optional in v0.1) ---

# Ollama endpoint for local AI enrichment. Leave empty if Ollama is not running;
# the system functions without AI suggestions in v0.1.
OLLAMA_URL=http://127.0.0.1:11434

# Embedding model. Used for v1.5 semantic search; not consumed in v0.1.
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Frontend (initialized at M1.1) ---

# Vite reads VITE_-prefixed variables. The frontend connects to PocketBase via
# this URL. For local dev, same as POCKETBASE_URL.
VITE_POCKETBASE_URL=http://127.0.0.1:8090
